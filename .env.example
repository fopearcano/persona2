# Configurazione backend PERSONA (facoltativa). Copiare in .env nella cartella server/ o esportare le variabili.
# Host di ascolto: per sicurezza resta su localhost.
PERSONA_HOST=127.0.0.1
PERSONA_PORT=4317
# Cartella dati (database SQLite, backup). Default: ./data nella root del progetto.
# PERSONA_DATA_DIR=/percorso/assoluto/data
# Endpoint LM Studio predefinito usato alla prima inizializzazione.
PERSONA_LMSTUDIO_URL=http://localhost:1234/v1
# Chiave API OpenAI (facoltativa). Resta sul backend e non viene mai inviata al frontend.
# OPENAI_API_KEY=
