# Configurazione backend PERSONA (facoltativa). Copiare in .env nella cartella server/ o esportare le variabili.
# Host di ascolto: per sicurezza resta su localhost.
PERSONA_HOST=127.0.0.1
PERSONA_PORT=4317
# Porta dell'interfaccia in sviluppo (npm run dev, Vite). Default 5111.
# PERSONA_WEB_PORT=5111
# Cartella dati (database SQLite, backup, libro). Default: la cartella utente del sistema, come l'app desktop:
#   Windows %APPDATA%\PERSONA\data · macOS ~/Library/Application Support/PERSONA/data · Linux ~/.config/PERSONA/data
# (una vecchia cartella ./data nel repository viene spostata lì al primo avvio).
# PERSONA_DATA_DIR=/percorso/assoluto/data
# Endpoint LM Studio predefinito usato alla prima inizializzazione.
PERSONA_LMSTUDIO_URL=http://localhost:1234/v1
# Chiave API OpenAI (facoltativa). Resta sul backend e non viene mai inviata al frontend.
# OPENAI_API_KEY=
# Libro di McKee per la ricerca e il coach (facoltativo): percorso di un file .epub.
# In alternativa caricalo da Impostazioni → Libro di McKee (resta nella cartella dati).
# PERSONA_BOOK_PATH=/percorso/assoluto/Character.epub
